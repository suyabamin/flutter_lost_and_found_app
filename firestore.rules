rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks Firestore for the user's role — NOT a client-supplied value.
    // This is a server-side read so it cannot be spoofed by the client.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function claimDoc(claimId) {
      return get(/databases/$(database)/documents/claims/$(claimId));
    }

    // Is the signed-in user a participant (owner OR claimer) of this claim?
    function isClaimParticipant(claimId) {
      return claimId != null &&
        claimId != '' &&
        exists(/databases/$(database)/documents/claims/$(claimId)) &&
        (claimDoc(claimId).data.postOwnerId == request.auth.uid ||
         claimDoc(claimId).data.claimerId == request.auth.uid);
    }

    // Is the signed-in user one participant AND targetUserId is the OTHER participant?
    // Used when one side updates the other side's user stats (ratings, recovery counts).
    function isOtherClaimParticipant(claimId, targetUserId) {
      return claimId != null &&
        claimId != '' &&
        exists(/databases/$(database)/documents/claims/$(claimId)) &&
        ((claimDoc(claimId).data.postOwnerId == request.auth.uid &&
          claimDoc(claimId).data.claimerId == targetUserId) ||
         (claimDoc(claimId).data.claimerId == request.auth.uid &&
          claimDoc(claimId).data.postOwnerId == targetUserId));
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only authenticated user can create their own document, preventing admin role self-assignment unless admin
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role != 'admin' ||
        isAdmin()
      );
      // Own profile update (role cannot be changed to admin by non-admin) OR other participant updating stats via verified claim
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          request.resource.data.role == resource.data.role ||
          isAdmin()
        )) ||
        isOtherClaimParticipant(request.resource.data.updatedViaClaimId, userId)
      );
      // Owner or Admin can delete user profile
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Owner can always update.
      // Claim participant can mark post as 'completed' or 'resolved' when item is recovered.
      // Admins can update any post for moderation.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin() ||
        (request.resource.data.status in ['completed', 'resolved'] && (
          isClaimParticipant(request.resource.data.completedClaimId) ||
          isClaimParticipant(resource.data.completedClaimId)
        ))
      );
      // Owner or Admin can delete post
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // ── Claims ────────────────────────────────────────────────────────────────
    match /claims/{claimId} {
      // Owner, claimer, or admin can read the claim document
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.postOwnerId ||
        request.auth.uid == resource.data.claimerId ||
        isAdmin()
      );
      // Authenticated user can submit a claim where they are the claimer
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.claimerId;
      // Post owner can approve/reject status or update location/confirmation;
      // Claimer can update live location, confirmation, and set status to 'completed' on completion;
      // Admins can update any claim.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.postOwnerId ||
        isAdmin() ||
        (request.auth.uid == resource.data.claimerId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status == resource.data.status ||
          request.resource.data.status == 'completed'
        ))
      );
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Signed-in users can read all notifications (app filters client-side by userId)
      allow read: if isSignedIn();
      // Any signed-in user can create notifications (claim flow creates for both parties)
      allow create: if isSignedIn();
      // Users can only update/delete their own notifications (e.g. mark as read), or admin
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
    }

    // ── Chat Rooms & Messages ─────────────────────────────────────────────────
    // ChatRoomModel uses `participants` as a List<String> array.
    match /chat_rooms/{roomId} {
      // All signed-in users can read (app filters client-side by participant)
      allow read: if isSignedIn();
      // Room participants or admins can update (lastMessage, unreadCount, etc.)
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      // Claim participants can create a chat room (must be in participants list)
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        // Room participants or admins can read messages
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants ||
          isAdmin()
        );
        // Sender's uid must match their auth uid and sender must be participant
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ── Ratings ───────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      // RatingModel stores 'fromUserId' / 'fromUser' — must match auth uid
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.fromUserId ||
        request.auth.uid == request.resource.data.fromUser
      );
      allow update, delete: if false;
    }

    // ── Reviews (duplicate archive of ratings) ────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.fromUserId ||
        request.auth.uid == request.resource.data.fromUser
      );
      allow update, delete: if false;
    }

    // ── Payments ──────────────────────────────────────────────────────────────
    // PaymentModel has no 'userId' field — app filters client-side by posterId/finderId.
    // confirmPaymentReceived updates payment status to 'completed'.
    match /payments/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Finder or Poster confirms receipt → updates status field
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ── History ───────────────────────────────────────────────────────────────
    match /history/{docId} {
      // App streams all and filters client-side by posterId/finderId
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Wallet ────────────────────────────────────────────────────────────────
    // updateWallet is called during reward payments — both own wallet and partner wallet.
    // Signed-in users need to read wallet to calculate updated totals without wiping out existing balances.
    match /wallet/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Campuses ──────────────────────────────────────────────────────────────
    match /campuses/{campusId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.creatorId;
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId ||
        isAdmin()
      );
    }

    // ── Campus Members ────────────────────────────────────────────────────────
    // Sensitive Student ID info protected; users can create/update their own membership doc
    match /campus_members/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    // Deterministic document ID: '${reporterId}_${postId}'
    // Security guarantees:
    //   - A user can only CREATE a report where they are the reporter (uid verified).
    //   - A user can READ their own reports or check if they've reported (resource == null); admins can read all.
    //   - Only admins (role verified server-side from users collection) can UPDATE status.
    //   - Nobody can DELETE reports (preserve moderation history).
    match /reports/{reportId} {
      // Reporter reads their own (or non-existent check); admin reads all
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
      // Reporter can create — uid must match reporterId field (cannot impersonate)
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.reporterId;
      // Only admin can update (change status, mark reviewed)
      allow update: if isAdmin();
      // Reports are never deleted — preserved for audit history
      allow delete: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
